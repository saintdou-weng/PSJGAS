    const p=psjgaProps_(),raw=p.getProperty(PSJGA_COMMAND.recent);
    let ids=raw?JSON.parse(raw):[];
    if(!Array.isArray(ids))throw syncError('STORAGE_STATE');
    if(ids.includes(id))return false;
    // Compact property below Apps Script's per-property storage limit.
    ids=[...ids.slice(-399),id];
    p.setProperty(PSJGA_COMMAND.recent,JSON.stringify(ids));
    return true;
  });
}

function psjgaCommandWebhook_(e){
  const p=psjgaProps_(),secret=p.getProperty(PSJGA_COMMAND.secret);
  if(!/^[a-f0-9]{64}$/.test(secret||'')||!psjgaEqual_(e.pathInfo,psjgaCommandPath_(secret)))return psjgaOutput_(psjgaReply_(false,{code:'BAD_REQUEST'}));
  const ack=()=>HtmlService.createHtmlOutput(PSJGA_COMMAND.ack);
  const raw=e?.postData?.contents;
  if(typeof raw!=='string'||!raw||raw.length>131072)return ack();
  let update;try{update=JSON.parse(raw);}catch{return ack();}
  const m=update?.message;
  if(!m||!Number.isSafeInteger(update.update_id)||update.update_id<0||
      !Number.isSafeInteger(m.message_id)||m.message_id<1||m.from?.is_bot||
      !['group','supergroup'].includes(m.chat?.type)||typeof m.text!=='string'||
      !/^\/psjga(?:@psjga_bot)?$/i.test(m.text.trim()))return ack();
  const started=Number(p.getProperty(PSJGA_COMMAND.started));
  if(!started||!Number.isSafeInteger(m.date)||m.date<started)return ack();
  try{
    const cfg=psjgaBotConfig_();
    if(String(m.chat.id)!==cfg.chat||!psjgaEqual_(p.getProperty(PSJGA_COMMAND.binding),cfg.fingerprint))return ack();
    if(!psjgaCommandClaim_(update.update_id))return ack();
    const body={
      chat_id:cfg.chat,
      text:'🏢 PSJGA · VRT 總務工作台\n點下方按鈕開啟平台。 / Open the platform below.',
      reply_markup:{inline_keyboard:[[{text:'開啟總務平台 · Open PSJGA',url:PSJGA_PLATFORM_URL}]]},
      reply_parameters:{message_id:m.message_id,allow_sending_without_reply:true},
      link_preview_options:{is_disabled:true},
    };
    if(m.is_topic_message===true&&Number.isSafeInteger(m.message_thread_id)&&m.message_thread_id>0)body.message_thread_id=m.message_thread_id;
    const sent=psjgaTelegram_(cfg,'sendMessage',body);
    if(!Number.isSafeInteger(sent?.message_id))throw syncError('TG_UNCERTAIN');
    psjgaCommandLast_('sent');
  }catch(err){
    // No blind retries after a Telegram timeout: the same message may have
    // reached the group. A new command from a member can always try again.
    const code=['TG_DENIED','TG_TOKEN','TG_RATE','TG_UNCERTAIN','TG_REJECTED','TG_CONFIG','BUSY'].includes(err?.code)?err.code:'COMMAND_ERROR';
    try{psjgaCommandLast_(code);}catch{}
  }
  return ack();
}
